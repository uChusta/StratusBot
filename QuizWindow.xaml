<Window x:Class="StratusBot.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Awareness Quiz" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        MinWidth="350" MinHeight="500"
        Background="LightSteelBlue">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="White" Margin="0">
            <!-- Header with Score Tracker -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Security Awareness Quiz" FontSize="18" FontWeight="Bold" RenderTransformOrigin="1.069,0.682" Height="20" Width="210"/>
                <TextBlock x:Name="QuestionNumberBlock" Text="Question 1 of 10" FontSize="14" Margin="40,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock x:Name="TopicBlock" Text="Topic: Phishing" FontSize="12" Margin="40,0,0,0" VerticalAlignment="Center" Foreground="#999"/>
                <TextBlock x:Name="ScoreBlock" Text="Score: 0/10" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="#0066CC"/>
            </StackPanel>

            <!-- Exit Button (Top Right) -->
            <Button 
                    x:Name="ExitButton"
                    Content="✕ Exit Quiz"
                    Width="110"
                    Height="36"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Background="#DC3545"
                    Foreground="White"
                    Cursor="Hand"
                    Click="ExitButton_Click"
                    VerticalAlignment="Center"
                    Padding="5" Margin="680,0,10,0"/>
        </Grid>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Question -->
                <TextBlock x:Name="QuestionBlock" 
                           Text="Loading question..." 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Foreground="#333"
                           TextWrapping="Wrap"
                           Margin="0,20,0,30"
                           MinHeight="60"/>

                <!-- Options Container -->
                <StackPanel x:Name="OptionsPanel" Margin="0,0,0,30">
                    <!-- Options will be generated dynamically -->
                </StackPanel>

                <!-- Feedback Area -->
                <Border x:Name="FeedbackBorder" 
                        BorderThickness="2" 
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,20,0,20"
                        Visibility="Collapsed"
                        Background="#F0F8FF">
                    <StackPanel>
                        <TextBlock x:Name="FeedbackTitleBlock" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="FeedbackTextBlock" 
                                   Text="" 
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="#333"/>
                    </StackPanel>
                </Border>

                <!-- Results Screen (Hidden by default) -->
                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                    <TextBlock Text="Quiz Complete!" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#0066CC"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>
                    <TextBlock x:Name="FinalScoreBlock" 
                               Text="Score: 0/10" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>
                    <TextBlock x:Name="ResultsMessageBlock" 
                               Text="" 
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,40"
                               MinHeight="80"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock x:Name="PercentageBlock" 
                                   Text="90%" 
                                   FontSize="32" 
                                   FontWeight="Bold"
                                   Foreground="#28A745"
                                   VerticalAlignment="Center"
                                   Margin="20"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons Area -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20" Height="50">
            <Button x:Name="SubmitButton" 
                    Content="Submit Answer" 
                    Width="140" 
                    Height="40"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Background="#0066CC" 
                    Foreground="White"
                    Cursor="Hand"
                    Click="SubmitButton_Click"
                    Margin="10,0"/>

            <Button x:Name="NextButton" 
                    Content="Next Question" 
                    Width="140" 
                    Height="40"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Background="#28A745" 
                    Foreground="White"
                    Cursor="Hand"
                    Click="NextButton_Click"
                    Margin="10,0"
                    Visibility="Collapsed"/>

            <Button x:Name="RetakeButton" 
                    Content="Retake Quiz"
                    Width="140" 
                    Height="40"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Background="#FF2D89EF" 
                    Foreground="White"
                    Cursor="Hand"
                    Click="RetakeButton_Click"
                    Margin="10,0"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>