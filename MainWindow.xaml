<Window x:Class="StratusBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StratusBot"
        mc:Ignorable="d"
        Title="StratusBot" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        MinWidth="350" MinHeight="850"
        Background="LightSteelBlue">
    <Grid>
        <!-- Row 0: Header with bot name and ASCII art -->
        <!-- Row 1: ScrollViewer containing chat display TextBlock -->
        <!-- Row 2: Input row with TextBox and Send Button -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Chat display -->
            <RowDefinition Height="Auto"/>
            <!-- Input row -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" 
                    Margin="10" 
                    HorizontalAlignment="Center">
            <TextBlock Text="Stratus Shield Cybersecurity Bot"
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="DarkBlue" 
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- User Display -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,5,5,0">
            <!--name must change to reflect actual user -->
            <TextBlock x:Name="UserDisplay" 
                       Text="User: John Doe" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"/>

            <Ellipse Name="StatusIndicator" 
                     Width="10" 
                     Height="10" 
                     Fill="Green" 
                     Margin="0,0,8,0" 
                     VerticalAlignment="Center"/>

        </StackPanel>
        <!--TabControl ChatBot and Task Assistant-->
        <TabControl Grid.Row="1" Margin="10">
        <!-- Chat Display Tab -->
        <TabItem Header="Chat">
            <Border Grid.Row="1" 
                Margin="0" 
                Background="LightCyan" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                Padding="5"
                CornerRadius="8">
            <ScrollViewer Name="ChatScrollViewer" 
                          VerticalScrollBarVisibility="Auto" 
                          ScrollChanged="ChatScrollViewer_ScrollChanged">
                <StackPanel Name="ChatDisplay" 
                            Orientation="Vertical">
                    <!-- Chat messages will be added here dynamically -->
                </StackPanel>
            </ScrollViewer>
        </Border>
        </TabItem>
            
        <!--Task assistant tab-->
        <TabItem Header="Tasks">
                <local:TaskAssistant/>
        </TabItem>
        </TabControl>

        <!-- Input Row -->
       <Grid Grid.Row="2" Margin="10" x:Name="InputRow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Input Row -->
            <Border CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="LightGray"
                    Background="White"
                    Padding="6"
                    Grid.Column="0"
                    SnapsToDevicePixels="True"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0" >

                <TextBox x:Name="InputTextBox" 
                         Grid.Column="0" 
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="4,2"
                         FontSize="14" />
            </Border>
            
            <!-- Send Button -->
            <Border CornerRadius="18"
                    Grid.Column="1"
                    Background="#FF2D89EF"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True"
                    Margin="0">
                
                <Button Name="SendButton" 
                    Content="Send"  
                    Foreground="White"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12,6"
                    MinWidth="80"
                    Click="SendButton_Click"/>
            </Border>


        </Grid>
    </Grid>
</Window>
